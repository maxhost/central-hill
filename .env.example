# ── Site origin (SEO/GEO: sitemaps, robots, llms.txt, JSON-LD) ───────────────
# Absolute public origin, no trailing slash. Falls back to NEXT_PUBLIC_SITE_URL,
# then to https://centralhill.pt (S13 / ADR 0020).
SITE_URL="https://centralhill.pt"

# ── Database (Neon Postgres) ─────────────────────────────────────────────────
# Pooled connection string for the app runtime; drizzle-kit also reads this.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Cloudflare R2 (media) ────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="central-hill-media"
# Public base for serving objects — the bucket's r2.dev development URL, no trailing
# slash. Read AT BUILD TIME for images.remotePatterns; a build without it ships a
# deployment where every optimised image 400s, so the build asserts on it (ADR 0024).
R2_PUBLIC_BASE_URL=""
# S3 API endpoint for THIS bucket, copied from the R2 dashboard — NOT assembled from a
# pattern. An EU-jurisdiction bucket (ADR 0015) lives on <account>.eu.r2.cloudflarestorage.com.
R2_S3_ENDPOINT=""

# ── Better Auth (backoffice only) ────────────────────────────────────────────
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Avantio (booking engine) ─────────────────────────────────────────────────
AVANTIO_ACCOUNT_ID=""

# ── Email (transactional, lead notifications) ────────────────────────────────
EMAIL_FROM=""
EMAIL_API_KEY=""

# ── LLM translation pipeline ─────────────────────────────────────────────────
TRANSLATE_API_KEY=""
